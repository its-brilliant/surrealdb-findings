DEFINE TABLE track TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;
DEFINE FIELD title      ON track TYPE string;
DEFINE FIELD duration_s ON track TYPE int;

DEFINE TABLE artist TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;
DEFINE FIELD name ON artist TYPE string;

DEFINE TABLE album TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;
DEFINE FIELD title ON album TYPE string;

DEFINE TABLE genre TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;
DEFINE FIELD label ON genre TYPE string;

DEFINE TABLE performed TYPE RELATION IN track OUT artist SCHEMAFULL PERMISSIONS FULL;
DEFINE FIELD ord ON performed TYPE int;
